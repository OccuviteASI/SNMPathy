# SNMPathy systemd unit.
#
#   sudo useradd --system --home /var/lib/snmpathy --create-home snmpathy
#   sudo python3 -m venv /opt/snmpathy && sudo /opt/snmpathy/bin/pip install /path/to/SNMPathy
#   sudo /opt/snmpathy/bin/snmpathy init-config /etc/snmpathy.yaml   # then edit it
#   sudo cp deploy/systemd/snmpathy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now snmpathy
[Unit]
Description=SNMPathy network monitoring (SNMP, syslog, uptime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snmpathy
Group=snmpathy
WorkingDirectory=/var/lib/snmpathy
Environment=SNMPATHY_DATABASE=/var/lib/snmpathy/snmpathy.db
ExecStart=/opt/snmpathy/bin/snmpathy serve --config /etc/snmpathy.yaml
Restart=on-failure
RestartSec=5

# Raw ICMP sockets for ping checks, and binding syslog to port 514 if you choose to.
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/snmpathy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
