  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "simpod-json-datasource",
          "uid": "snmpathy"
        },
        "query": {
          "query": "devices",
          "format": "string",
          "refId": "var-device"
        },
        "definition": "devices",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
