{
  "uid": "snmpathy-overview",
  "title": "SNMPathy - Network Overview",
  "description": "Health, traffic, availability and logs.",
  "tags": [
    "snmpathy",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
