{
  "uid": "snmpathy-device",
  "title": "SNMPathy - Device",
  "description": "Per-device drill down.",
  "tags": [
    "snmpathy",
    "device"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "simpod-json-datasource",
          "uid": "snmpathy"
        },
        "query": {
          "query": "devices",
          "format": "string",
          "refId": "var-device"
        },
        "definition": "devices",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "allValue": "*",
        "current": {},
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "SNMPathy dashboards",
      "type": "dashboards",
      "tags": [
        "snmpathy"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "simpod-json-datasource",
        "uid": "snmpathy"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "snmpathy"
          },
          "target": "metric",
          "payload": {
            "key": "cpu.load",
            "device": "$device",
            "limit": "32"
          },
          "editorMode": "builder"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "snmpathy"
          },
          "target": "metric",
          "payload": {
            "key": "cpu.avg",
            "device": "$device"
          },
          "editorMode": "builder"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": 600000,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
