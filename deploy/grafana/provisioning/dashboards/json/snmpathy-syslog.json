{
  "uid": "snmpathy-syslog",
  "title": "SNMPathy - Syslog",
  "description": "Log volume and messages.",
  "tags": [
    "snmpathy",
    "syslog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "simpod-json-datasource",
          "uid": "snmpathy"
        },
        "query": {
          "query": "hosts",
          "format": "string",
          "refId": "var-host"
        },
        "definition": "hosts",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "SNMPathy dashboards",
      "type": "dashboards",
      "tags": [
        "snmpathy"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Messages by severity",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "simpod-json-datasource",
        "uid": "snmpathy"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "snmpathy"
          },
          "target": "syslog",
          "payload": {
            "host": "$host",
            "split": "true"
          },
          "editorMode": "builder"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": 600000,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest errors (err and worse)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "simpod-json-datasource",
        "uid": "snmpathy"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "snmpathy"
          },
          "target": "syslog_events",
          "payload": {
            "severity": "3",
            "host": "$host",
            "limit": "200"
          },
          "editorMode": "builder"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest messages",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "simpod-json-datasource",
        "uid": "snmpathy"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "simpod-json-datasource",
            "uid": "snmpathy"
          },
          "target": "syslog_events",
          "payload": {
            "host": "$host",
            "limit": "500"
          },
          "editorMode": "builder"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
